---
import Layout from '../layouts/Layout.astro';

const CATEGORIES = [
  'restaurant','cafe','bar','fast_food','hotel',
  'dentist','doctor','hairdresser','beauty','gym',
  'pharmacy','plumber','electrician','lawyer','accountant',
  'estate_agent','mechanic','florist','bakery','optician',
  'veterinary','tattoo','travel','insurance','cleaning',
  'photographer','butcher',
];

const API = import.meta.env.API_URL ?? 'http://localhost:8000';
---

<Layout title="Spruce My Site — Lead Generator">

  <!-- Hero -->
  <section class="pt-16 pb-10 px-4 text-center">
    <div class="inline-flex items-center gap-2 bg-blue-500/10 border border-blue-500/20 rounded-full px-4 py-1.5 text-blue-400 text-sm font-medium mb-6">
      <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
      Powered by OpenStreetMap · No API key needed
    </div>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
      Find businesses with
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-400">
        weak&nbsp;websites
      </span>
    </h1>
    <p class="text-slate-400 text-lg max-w-xl mx-auto">
      Score websites 0–100, map their full tech stack, and surface every
      <strong class="text-slate-300">Spruce My Site</strong> service they're missing.
    </p>
  </section>

  <!-- Form card -->
  <section class="max-w-2xl mx-auto px-4 pb-20">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl p-6 sm:p-8 shadow-2xl">
      <form id="scan-form" class="space-y-5">

        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1.5" for="location">
            Location
          </label>
          <input
            id="location" name="location" type="text"
            placeholder="e.g. Manchester, UK · Austin, TX · Sydney"
            required
            class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-2.5
                   text-slate-100 placeholder-slate-500 focus:outline-none
                   focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
          />
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5" for="category">
              Business category
            </label>
            <select
              id="category" name="category"
              class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-2.5
                     text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500
                     focus:border-transparent transition cursor-pointer"
            >
              {CATEGORIES.map(c => (
                <option value={c}>{c.replace(/_/g,' ')}</option>
              ))}
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5" for="radius">
              Search radius (km)
            </label>
            <input
              id="radius" name="radius" type="number"
              value="5" min="0.5" max="50" step="0.5"
              class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-2.5
                     text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500
                     focus:border-transparent transition"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5" for="limit">
              Max businesses
            </label>
            <input
              id="limit" name="limit" type="number"
              value="30" min="5" max="100" step="5"
              class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-2.5
                     text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500
                     focus:border-transparent transition"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5" for="workers">
              Parallel analysers
            </label>
            <input
              id="workers" name="workers" type="number"
              value="5" min="1" max="10"
              class="w-full bg-slate-800 border border-slate-600 rounded-lg px-4 py-2.5
                     text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500
                     focus:border-transparent transition"
            />
          </div>
        </div>

        <button
          type="submit"
          class="w-full bg-blue-600 hover:bg-blue-500 active:scale-[.98]
                 text-white font-semibold py-3 rounded-xl transition
                 flex items-center justify-center gap-2 text-base"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z"/>
          </svg>
          Start Lead Scan
        </button>

        <p id="error-msg" class="hidden text-red-400 text-sm text-center"></p>
      </form>
    </div>

    <!-- Feature chips -->
    <div class="mt-8 flex flex-wrap justify-center gap-2.5">
      {[
        ['🔒','SSL/HTTPS check'],['⚡','Speed score'],['📱','Mobile ready'],
        ['🔍','SEO signals'],['🛠','Full tech stack'],['💡','Spruce opportunities'],
      ].map(([icon, label]) => (
        <span class="flex items-center gap-1.5 text-sm text-slate-400
                     bg-slate-800/60 border border-slate-700 rounded-full px-3 py-1">
          {icon} {label}
        </span>
      ))}
    </div>
  </section>

</Layout>

<script define:vars={{ API }}>
  document.getElementById('scan-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const errEl = document.getElementById('error-msg');
    errEl.classList.add('hidden');

    const btn = e.target.querySelector('button[type=submit]');
    btn.disabled = true;
    btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path></svg> Starting…';

    const body = {
      location: document.getElementById('location').value.trim(),
      category: document.getElementById('category').value,
      radius:   parseFloat(document.getElementById('radius').value),
      limit:    parseInt(document.getElementById('limit').value),
      workers:  parseInt(document.getElementById('workers').value),
      timeout:  10,
    };

    try {
      const res = await fetch(`${API}/api/scan`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error(await res.text());
      const { job_id } = await res.json();
      const params = new URLSearchParams({
        location: body.location,
        category: body.category,
        api: API,
      });
      window.location.href = `/results/${job_id}?${params}`;
    } catch (ex) {
      errEl.textContent = `Error: ${ex.message}`;
      errEl.classList.remove('hidden');
      btn.disabled = false;
      btn.innerHTML = 'Start Lead Scan';
    }
  });
</script>
