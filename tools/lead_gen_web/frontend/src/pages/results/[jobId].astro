---
import Layout from '../../layouts/Layout.astro';

const { jobId } = Astro.params;
const location = Astro.url.searchParams.get('location') ?? '';
const category = Astro.url.searchParams.get('category') ?? '';
const api      = Astro.url.searchParams.get('api') ?? 'http://localhost:8000';
---

<Layout title={`Leads — ${location} ${category}`}>

<!-- Top bar -->
<div class="border-b border-slate-800 bg-slate-900/60 sticky top-14 z-40 px-4">
  <div class="max-w-7xl mx-auto h-12 flex items-center gap-3 text-sm">
    <span class="text-slate-400">📍 <strong class="text-slate-200">{location}</strong></span>
    <span class="text-slate-600">·</span>
    <span class="text-slate-400">🏷 <strong class="text-slate-200">{category}</strong></span>
    <div id="progress-pill" class="ml-auto flex items-center gap-2 text-xs text-slate-400">
      <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
      <span id="progress-text">Connecting…</span>
    </div>
  </div>
</div>

<!-- Stats row -->
<div id="stats-row" class="max-w-7xl mx-auto px-4 py-4 grid grid-cols-2 sm:grid-cols-5 gap-3">
  {[
    ['total',        'Businesses',     'text-blue-400'],
    ['with_site',    'Have Website',   'text-slate-200'],
    ['without_site', 'No Website',     'text-red-400'],
    ['avg_score',    'Avg Score /100', 'text-slate-200'],
    ['prime_leads',  'Prime Leads',    'text-red-400'],
  ].map(([id, label, cls]) => (
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
      <div id={`stat-${id}`} class={`text-2xl font-bold shimmer rounded w-12 h-7 ${cls}`}>—</div>
      <div class="text-xs text-slate-500 uppercase tracking-wider mt-1">{label}</div>
    </div>
  ))}
</div>

<!-- Two-column body -->
<div class="max-w-7xl mx-auto px-4 pb-12 grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-6">

  <!-- Lead table -->
  <div>

    <!-- Controls -->
    <div class="flex flex-wrap gap-3 mb-4 items-center">
      <input
        id="search" type="text" placeholder="Filter by name, tech, address…"
        class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm
               text-slate-100 placeholder-slate-500 focus:outline-none
               focus:ring-2 focus:ring-blue-500 w-56 transition"
      />
      <select id="grade-filter"
        class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm
               text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500
               cursor-pointer transition">
        <option value="">All grades</option>
        <option value="No Website">No Website</option>
        <option value="Prime">Prime</option>
        <option value="Good">Good</option>
        <option value="Moderate">Moderate</option>
        <option value="Low">Low</option>
      </select>
      <button id="export-btn"
        class="ml-auto bg-slate-800 hover:bg-slate-700 border border-slate-600
               text-slate-300 text-sm font-medium px-4 py-2 rounded-lg transition flex items-center gap-2">
        ⬇ Export CSV
      </button>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto rounded-xl border border-slate-800">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-slate-900 text-slate-400 text-xs uppercase tracking-wider">
            <th class="px-4 py-3 text-left cursor-pointer hover:text-slate-200" data-col="0">Business ↕</th>
            <th class="px-4 py-3 text-left cursor-pointer hover:text-slate-200" data-col="1">Website ↕</th>
            <th class="px-4 py-3 text-left cursor-pointer hover:text-slate-200 min-w-[140px]" data-col="2">Score ↕</th>
            <th class="px-4 py-3 text-left">Tech Stack</th>
            <th class="px-4 py-3 text-left">Spruce Opportunities</th>
            <th class="px-4 py-3 text-left">Phone</th>
          </tr>
        </thead>
        <tbody id="leads-tbody">
          <!-- Rows injected by JS -->
          <tr id="empty-row">
            <td colspan="6" class="px-4 py-12 text-center text-slate-500">
              <div class="shimmer h-4 w-48 rounded mx-auto mb-2"></div>
              <div class="shimmer h-4 w-32 rounded mx-auto"></div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="space-y-5">

    <!-- Top opportunities -->
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
      <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">
        Top Opportunities
      </h3>
      <div id="opp-bars" class="space-y-2.5">
        {Array(6).fill(0).map(() => (
          <div class="shimmer h-4 rounded"></div>
        ))}
      </div>
    </div>

    <!-- Score legend -->
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
      <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">
        Score Guide
      </h3>
      <div class="space-y-2 text-sm">
        {[
          ['#ef4444','0–30','Prime Lead'],
          ['#f97316','31–50','Good Lead'],
          ['#eab308','51–70','Moderate'],
          ['#22c55e','71–85','Good Site'],
          ['#3b82f6','86–100','Excellent'],
        ].map(([c, range, label]) => (
          <div class="flex items-center gap-2.5">
            <span class="w-3 h-3 rounded-full flex-shrink-0" style={`background:${c}`}></span>
            <span class="text-slate-400">{range}</span>
            <span class="text-slate-300 ml-auto">{label}</span>
          </div>
        ))}
      </div>
      <div class="mt-4 pt-4 border-t border-slate-800 text-xs text-slate-500 space-y-1">
        <div>🔒 HTTPS /20 &nbsp; ⚡ Speed /20</div>
        <div>📱 Mobile /15 &nbsp; 🔍 SEO /25</div>
        <div>📋 Content /20</div>
      </div>
    </div>

  </div>
</div>

</Layout>

<script define:vars={{ jobId, api }}>

// ── Helpers ──────────────────────────────────────────────────────────────────

function scoreColor(s) {
  if (s == null) return '#94a3b8';
  if (s <= 30)   return '#ef4444';
  if (s <= 50)   return '#f97316';
  if (s <= 70)   return '#eab308';
  if (s <= 85)   return '#22c55e';
  return '#3b82f6';
}

function gradeClass(grade) {
  return {
    'No Website':  'bg-red-500/15 text-red-400',
    'Prime':       'bg-red-500/15 text-red-400',
    'Good':        'bg-orange-500/15 text-orange-400',
    'Moderate':    'bg-yellow-500/15 text-yellow-400',
    'Low':         'bg-green-500/15 text-green-400',
    'Unreachable': 'bg-slate-500/15 text-slate-400',
  }[grade] ?? 'bg-slate-500/15 text-slate-400';
}

function techBadges(ts) {
  if (!ts) return '';
  const items = [
    ts.cms, ts.framework, ts.js_lib, ts.css_fw, ts.server, ts.cdn, ts.backend,
    ...(ts.analytics || []),
    ts.ecommerce, ts.chat, ts.marketing, ts.maps, ts.payment,
  ].filter(Boolean).slice(0, 8);
  if (!items.length) return '<span class="text-slate-600 text-xs">Unknown</span>';
  return items.map(t =>
    `<span class="inline-block bg-blue-500/10 text-blue-300 border border-blue-500/20
       rounded px-1.5 py-0.5 text-[11px] mr-0.5 mb-0.5">${t}</span>`
  ).join('');
}

function oppBadges(missing) {
  if (!missing || !missing.length) {
    return '<span class="text-green-400 text-xs">✓ Well equipped</span>';
  }
  return missing.map(({label, description}) =>
    `<span class="inline-block bg-orange-500/10 text-orange-300 border border-orange-500/20
       rounded px-1.5 py-0.5 text-[11px] mr-0.5 mb-0.5 cursor-default"
       title="${description}">${label}</span>`
  ).join('');
}

function mapsUrl(lat, lon) {
  return `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}&zoom=17`;
}

// ── Row builder ───────────────────────────────────────────────────────────────

function buildRow(b) {
  const tr = document.createElement('tr');
  tr.className = 'border-t border-slate-800 hover:bg-slate-800/40 transition-colors';
  tr.dataset.name    = b.name;
  tr.dataset.address = b.address;
  tr.dataset.grade   = b.lead_grade;
  tr.dataset.score   = b.score ?? -1;

  const siteCell = b.website
    ? `<a href="${b.final_url || b.website}" target="_blank" rel="noopener"
          class="text-blue-400 hover:text-blue-300 break-all text-xs leading-relaxed">
         ${(b.final_url || b.website).replace(/^https?:\/\//, '').replace(/\/$/, '').slice(0, 40)}
       </a>`
    : '<span class="text-slate-600 text-xs">None</span>';

  let scoreCell;
  if (b.score != null) {
    const col = scoreColor(b.score);
    const bd  = b.score_breakdown || {};
    scoreCell = `
      <div class="flex flex-col gap-1">
        <span class="text-lg font-bold leading-none" style="color:${col}">${b.score}</span>
        <div class="h-1.5 rounded bg-slate-700 overflow-hidden w-24">
          <div class="h-full rounded transition-all" style="width:${b.score}%;background:${col}"></div>
        </div>
        <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold uppercase
                     tracking-wider ${gradeClass(b.lead_grade)}">${b.lead_grade}</span>
        <span class="text-[10px] text-slate-500">
          🔒${bd.https??0} ⚡${bd.speed??0} 📱${bd.mobile??0} 🔍${bd.seo??0} 📋${bd.content??0}
        </span>
      </div>`;
  } else if (!b.website) {
    scoreCell = `<span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold
                   uppercase tracking-wider ${gradeClass('No Website')}">No Website</span>`;
  } else {
    scoreCell = `<span class="text-slate-500 text-xs" title="${b.error}">Error</span>`;
  }

  tr.innerHTML = `
    <td class="px-4 py-3 align-top">
      <div class="font-semibold text-slate-100 leading-snug">${b.name}</div>
      <div class="text-xs text-slate-500 mt-0.5">${b.address || '—'}</div>
      ${b.lat ? `<a href="${mapsUrl(b.lat,b.lon)}" target="_blank" rel="noopener"
                    class="text-[10px] text-slate-600 hover:text-blue-400 transition-colors">📍 Map</a>` : ''}
    </td>
    <td class="px-4 py-3 align-top max-w-[160px]">${siteCell}</td>
    <td class="px-4 py-3 align-top">${scoreCell}</td>
    <td class="px-4 py-3 align-top">${techBadges(b.tech_stack)}</td>
    <td class="px-4 py-3 align-top">${oppBadges(b.missing_services)}</td>
    <td class="px-4 py-3 align-top text-xs text-slate-400">${b.phone || '—'}</td>
  `;
  return tr;
}

// ── SSE stream ────────────────────────────────────────────────────────────────

const tbody     = document.getElementById('leads-tbody');
const emptyRow  = document.getElementById('empty-row');
const progPill  = document.getElementById('progress-text');

// Track analysed businesses keyed by name to update rows in-place
const rowMap = {};
// All businesses for sorting / filtering
let allBusinesses = [];

function upsertRow(b) {
  allBusinesses = allBusinesses.filter(x => x.name !== b.name);
  allBusinesses.push(b);

  const existing = rowMap[b.name];
  const newRow   = buildRow(b);

  if (existing) {
    existing.replaceWith(newRow);
  } else {
    emptyRow.remove();
    tbody.appendChild(newRow);
  }
  rowMap[b.name] = newRow;
  applyFilter();
}

function setStat(id, val) {
  const el = document.getElementById(`stat-${id}`);
  if (el) { el.textContent = val; el.classList.remove('shimmer','rounded','w-12','h-7'); }
}

function renderOppBars(topOpps) {
  const container = document.getElementById('opp-bars');
  if (!topOpps || !topOpps.length) { container.innerHTML = '<p class="text-slate-500 text-xs">—</p>'; return; }
  const max = topOpps[0].count;
  container.innerHTML = topOpps.map(({ label, count }) => `
    <div class="flex items-center gap-2">
      <span class="text-xs text-slate-300 w-32 truncate">${label}</span>
      <div class="flex-1 bg-slate-800 rounded h-1.5 overflow-hidden">
        <div class="h-full bg-orange-400 rounded" style="width:${Math.round(count/max*100)}%"></div>
      </div>
      <span class="text-xs text-slate-500 w-5 text-right">${count}</span>
    </div>`).join('');
}

// Discovery phase: insert skeleton rows with name + no-website flag
function handleDiscovery({ businesses }) {
  businesses.forEach(b => {
    if (!rowMap[b.name]) {
      allBusinesses.push(b);
      const tr = buildRow(b);
      emptyRow.remove();
      tbody.appendChild(tr);
      rowMap[b.name] = tr;
    }
  });
  setStat('total', businesses.length);
  setStat('with_site',    businesses.filter(b => b.website).length);
  setStat('without_site', businesses.filter(b => !b.website).length);
}

function handleDone({ summary, businesses }) {
  businesses.forEach(b => upsertRow(b));
  setStat('total',        summary.total        ?? '—');
  setStat('with_site',    summary.with_site    ?? '—');
  setStat('without_site', summary.without_site ?? '—');
  setStat('avg_score',    summary.avg_score    ?? '—');
  setStat('prime_leads',  summary.prime_leads  ?? '—');
  renderOppBars(summary.top_opportunities);

  progPill.textContent = '✓ Scan complete';
  document.getElementById('progress-pill').querySelector('span').classList.remove('animate-pulse');
  document.getElementById('progress-pill').querySelector('span').classList.add('bg-green-400');
  document.getElementById('progress-pill').querySelector('span').classList.remove('bg-blue-400');
}

const evtSrc = new EventSource(`${api}/api/scan/${jobId}/stream`);

evtSrc.onmessage = (e) => {
  const { event, data } = JSON.parse(e.data);

  if (event === 'log') {
    progPill.textContent = data;
  } else if (event === 'discovery') {
    handleDiscovery(data);
    progPill.textContent = `Analysing ${data.with_site} websites…`;
  } else if (event === 'business_analysed') {
    const { progress, business } = data;
    upsertRow(business);
    progPill.textContent = `Analysed ${progress.done}/${progress.total}`;
  } else if (event === 'done') {
    handleDone(data);
    evtSrc.close();
  } else if (event === 'error') {
    progPill.textContent = `Error: ${data.message}`;
    evtSrc.close();
  }
};

evtSrc.onerror = () => {
  progPill.textContent = 'Connection lost — results may be partial';
  evtSrc.close();
};

// ── Filter / sort ─────────────────────────────────────────────────────────────

function applyFilter() {
  const q = document.getElementById('search').value.toLowerCase();
  const g = document.getElementById('grade-filter').value;
  tbody.querySelectorAll('tr:not(#empty-row)').forEach(tr => {
    const text  = tr.textContent.toLowerCase();
    const grade = tr.dataset.grade ?? '';
    tr.classList.toggle('hidden',
      (q && !text.includes(q)) || (g && grade !== g)
    );
  });
}

document.getElementById('search').addEventListener('input', applyFilter);
document.getElementById('grade-filter').addEventListener('change', applyFilter);

// Sort by column header click
let sortCol = 2, sortAsc = true;
document.querySelectorAll('th[data-col]').forEach(th => {
  th.addEventListener('click', () => {
    const col = parseInt(th.dataset.col);
    if (sortCol === col) sortAsc = !sortAsc;
    else { sortCol = col; sortAsc = true; }

    const rows = [...tbody.querySelectorAll('tr:not(#empty-row)')];
    rows.sort((a, b) => {
      const av = a.cells[col]?.textContent.trim() ?? '';
      const bv = b.cells[col]?.textContent.trim() ?? '';
      // Score column: numeric sort
      if (col === 2) {
        const an = parseFloat(a.dataset.score ?? av);
        const bn = parseFloat(b.dataset.score ?? bv);
        if (!isNaN(an) && !isNaN(bn)) return sortAsc ? an - bn : bn - an;
      }
      return sortAsc ? av.localeCompare(bv) : bv.localeCompare(av);
    });
    rows.forEach(r => tbody.appendChild(r));
  });
});

// ── CSV export ────────────────────────────────────────────────────────────────

document.getElementById('export-btn').addEventListener('click', () => {
  const vis = [...tbody.querySelectorAll('tr:not(.hidden):not(#empty-row)')];
  const hdr = ['Name','Address','Website','Score','Grade','Tech Stack','Spruce Opportunities','Phone'];
  const data = [hdr, ...vis.map(r => {
    const b = allBusinesses.find(x => x.name === r.dataset.name) ?? {};
    return [
      b.name ?? '',
      b.address ?? '',
      b.final_url || b.website || '',
      b.score ?? '',
      b.lead_grade ?? '',
      b.tech_stack ? [b.tech_stack.cms, b.tech_stack.framework, b.tech_stack.server,
        ...(b.tech_stack.analytics||[])].filter(Boolean).join(', ') : '',
      (b.missing_services || []).map(s => s.label).join(', '),
      b.phone ?? '',
    ];
  })];
  const csv  = data.map(r => r.map(c => `"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n');
  const blob = new Blob([csv], { type: 'text/csv' });
  const a    = Object.assign(document.createElement('a'), {
    href: URL.createObjectURL(blob),
    download: `spruce_leads_${Date.now()}.csv`,
  });
  a.click();
});

</script>
